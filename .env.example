# ─── Firebase (Google Auth) ──────────────────────────────────────────────
# Client-side (browser) — must be prefixed with NEXT_PUBLIC_.
# From: Firebase Console → Project Settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Server-side (service account) — used to verify Google ID tokens.
# From: Firebase Console → Project Settings → Service Accounts →
#        "Generate new private key" → open the JSON and copy these 3 fields.
# Keep the private key secret. Paste it with its \n escapes intact, e.g.
# "-----BEGIN PRIVATE KEY-----\nABCD...\n-----END PRIVATE KEY-----\n"
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Cloudinary (media storage) ──────────────────────────────────────────
# Server-side only (NOT public). From: Cloudinary Console → Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── PostgreSQL (room + media persistence) ───────────────────────────────
# Server-side only. On Render, create a PostgreSQL DB and use its Internal URL.
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Set to "true" if your DB requires SSL (Render external URL does; internal usually doesn't)
DATABASE_SSL=false
